      "skills": [
        "coding-standards",
        "tdd-workflow",
        "verification-loop"
      ],
      "commands": {
        "build": ["npm run build"],
        "test": ["npm test", "npx jest", "npx vitest"],
        "lint": ["npx eslint ."],
        "format": ["npx prettier --write ."]
      },
      "permissions": {
        "allow": ["npx eslint", "npx prettier", "npm test", "npm run *", "npx jest", "npx vitest"],
        "deny": ["npm publish"]
      }
    },
    {
      "id": "react",
      "name": "React",
      "indicators": [
        { "file": "package.json", "contains": "\"react\":" }
      ],
      "rules": ["common", "typescript", "web", "react"],
      "skills": [
        "coding-standards",
        "frontend-patterns",
        "react-patterns",
        "react-performance",
