{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node docs/examples/hook-authoring/example-hook-pre.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node docs/examples/hook-authoring/example-hook-post.js"
          }
        ]
      }
    ]
  }
}
